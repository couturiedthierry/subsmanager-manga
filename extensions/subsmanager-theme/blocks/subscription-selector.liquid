{% liquid
  assign selected_product = block.settings.product | default: product
  assign selected_variant = selected_product.selected_or_first_available_variant
  assign allocation_count = selected_variant.selling_plan_allocations.size
  assign subscription_only = selected_product.requires_selling_plan
  assign product_form_id = 'product-form-' | append: section.id

  # Store-wide switch from the app's Settings page. Missing setting means "on".
  assign app_settings = shop.metafields.subsmanager.settings.value
  assign widget_enabled = true
  if app_settings and app_settings.productWidget == false and subscription_only == false
    assign widget_enabled = false
  endif

  assign subscribe_by_default = false
  if block.settings.default_option == 'subscription' or subscription_only
    assign subscribe_by_default = true
  endif

  assign first_allocation = selected_variant.selling_plan_allocations.first
  assign best_saving = 0
  for allocation in selected_variant.selling_plan_allocations
    assign base_price = allocation.compare_at_price | default: selected_variant.price
    if base_price > allocation.price
      assign saving = base_price | minus: allocation.price | times: 100.0 | divided_by: base_price | round
      if saving > best_saving
        assign best_saving = saving
      endif
    endif
  endfor
  assign first_base = first_allocation.compare_at_price | default: selected_variant.price
  assign best_saving_text = best_saving | append: '%'
  assign badge_label = block.settings.badge_text | replace: '[saving]', best_saving_text
%}

{% if widget_enabled == false and request.design_mode %}
  <p style="border:1px dashed #b4b4b4;border-radius:8px;padding:12px;font-size:14px;opacity:.8">
    Subscription options are turned off in the SubsManager Manga app (Settings → Product page and customer portal).
    Customers don't see this message.
  </p>
{% endif %}

{% if widget_enabled and selected_product != blank and allocation_count > 0 %}
  {{ 'subsmanager.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'subsmanager.js' | asset_url }}" defer="defer"></script>

  <subsmanager-widget
    class="sm-widget{% if block.settings.one_time_first %} sm-widget--one-time-first{% endif %}"
    data-product-form="{{ product_form_id }}"
    data-initial-variant="{{ selected_variant.id }}"
    data-save-template="{{ block.settings.saving_text | escape }}"
    data-badge-template="{{ block.settings.badge_text | escape }}"
    style="--sm-accent: {{ block.settings.accent_color }}; --sm-accent-text: {{ block.settings.accent_text_color }}; --sm-surface: {{ block.settings.background_color }}; --sm-border: {{ block.settings.border_color }}; --sm-radius: {{ block.settings.corner_radius }}px;"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.heading != blank %}
      <p class="sm-widget__heading">{{ block.settings.heading | escape }}</p>
    {% endif %}

    <div
      class="sm-option sm-option--subscription{% if subscribe_by_default %} is-selected{% endif %}"
      data-sm-subscription-option
    >
      {% if block.settings.show_badge and best_saving > 0 %}
        <span class="sm-badge" data-sm-badge>{{ badge_label | escape }}</span>
      {% else %}
        <span class="sm-badge" data-sm-badge {% unless block.settings.show_badge %}data-disabled="true"{% endunless %} hidden></span>
      {% endif %}

      <label class="sm-option__head">
        <input
          class="sm-radio"
          type="radio"
          name="sm-purchase-{{ block.id }}"
          value="subscription"
          data-purchase-type="subscription"
          {% if subscribe_by_default %}checked{% endif %}
        >
        <span class="sm-option__title">{{ block.settings.subscribe_label | escape }}</span>
        <span class="sm-option__price">
          <s class="sm-compare" data-sm-compare {% unless first_base > first_allocation.price %}hidden{% endunless %}>{{ first_base | money }}</s>
          <strong data-sm-subscription-price>{{ first_allocation.price | money }}</strong>
        </span>
      </label>

      <div class="sm-option__body">
        {% if block.settings.benefit_1 != blank or block.settings.benefit_2 != blank or block.settings.benefit_3 != blank %}
          <ul class="sm-benefits" role="list">
            {% for i in (1..3) %}
              {% assign benefit_key = 'benefit_' | append: i %}
              {% assign benefit = block.settings[benefit_key] %}
              {% if benefit != blank %}
                <li>
                  <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{{ benefit | escape }}</span>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        <p class="sm-frequency-label" id="sm-frequency-label-{{ block.id }}">{{ block.settings.frequency_label | escape }}</p>
        <div class="sm-frequencies" role="radiogroup" aria-labelledby="sm-frequency-label-{{ block.id }}" data-sm-frequencies>
          {% for allocation in selected_variant.selling_plan_allocations %}
            {% liquid
              assign base_price = allocation.compare_at_price | default: selected_variant.price
              assign saving = 0
              if base_price > allocation.price
                assign saving = base_price | minus: allocation.price | times: 100.0 | divided_by: base_price | round
              endif
              assign label = allocation.selling_plan.options.first.value | default: allocation.selling_plan.name | remove_first: 'Every ' | remove_first: 'every '
              assign saving_value = saving | append: '%'
              assign saving_label = block.settings.saving_text | replace: '[saving]', saving_value
            %}
            <label class="sm-frequency">
              <input
                type="radio"
                name="sm-plan-{{ block.id }}"
                value="{{ allocation.selling_plan.id }}"
                {% if forloop.first %}checked{% endif %}
              >
              <span class="sm-frequency__label">{{ label | escape }}</span>
              {% if saving > 0 %}
                <span class="sm-frequency__saving">{{ saving_label | escape }}</span>
              {% endif %}
            </label>
          {% endfor %}
        </div>
      </div>
    </div>

    <label class="sm-option sm-option--one-time{% unless subscribe_by_default %} is-selected{% endunless %}" data-sm-one-time-option {% if subscription_only %}hidden{% endif %}>
      <span class="sm-option__head">
        <input
          class="sm-radio"
          type="radio"
          name="sm-purchase-{{ block.id }}"
          value=""
          data-purchase-type="one-time"
          {% unless subscribe_by_default %}checked{% endunless %}
        >
        <span class="sm-option__title">{{ block.settings.one_time_label | escape }}</span>
        <span class="sm-option__price" data-sm-one-time-price>{{ selected_variant.price | money }}</span>
      </span>
    </label>

    {% if block.settings.renewal_note != blank %}
      <p class="sm-note">{{ block.settings.renewal_note | escape }}</p>
    {% endif %}

    <input type="hidden" name="selling_plan" form="{{ product_form_id }}" value="" data-sm-selling-plan disabled>

    <script type="application/json" data-sm-variants>
      {
        {% for variant in selected_product.variants %}
          "{{ variant.id }}": {
            "oneTimePrice": {{ variant.price | money | json }},
            "allocations": [
              {% for allocation in variant.selling_plan_allocations %}
                {% liquid
                  assign base_price = allocation.compare_at_price | default: variant.price
                  assign saving = 0
                  if base_price > allocation.price
                    assign saving = base_price | minus: allocation.price | times: 100.0 | divided_by: base_price | round
                  endif
                  assign label = allocation.selling_plan.options.first.value | default: allocation.selling_plan.name | remove_first: 'Every ' | remove_first: 'every '
                %}
                {
                  "id": "{{ allocation.selling_plan.id }}",
                  "label": {{ label | json }},
                  "price": {{ allocation.price | money | json }},
                  "compare": {% if base_price > allocation.price %}{{ base_price | money | json }}{% else %}""{% endif %},
                  "saving": {{ saving | json }}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ]
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      }
    </script>
  </subsmanager-widget>
{% endif %}

{% schema %}
{
  "name": "Subscription selector",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    { "type": "text", "id": "subscribe_label", "label": "Subscription option", "default": "Subscribe & save" },
    { "type": "text", "id": "one_time_label", "label": "One-time option", "default": "One-time purchase" },
    { "type": "text", "id": "frequency_label", "label": "Frequency label", "default": "Deliver every:" },
    {
      "type": "text",
      "id": "saving_text",
      "label": "Saving under each frequency",
      "info": "[saving] is replaced with the percentage, for example \"save 20%\".",
      "default": "save [saving]"
    },
    { "type": "text", "id": "benefit_1", "label": "Benefit 1", "default": "No commitment — pause or cancel anytime" },
    { "type": "text", "id": "benefit_2", "label": "Benefit 2", "default": "Skip or reschedule deliveries from your account" },
    { "type": "text", "id": "benefit_3", "label": "Benefit 3", "default": "" },
    {
      "type": "text",
      "id": "renewal_note",
      "label": "Note under the options",
      "default": "Subscription orders repeat at the frequency you choose. Manage everything from your account."
    },
    { "type": "header", "content": "Savings badge" },
    { "type": "checkbox", "id": "show_badge", "label": "Show savings badge", "default": true },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "info": "[saving] is replaced with the best available saving.",
      "default": "SAVE UP TO [saving]"
    },
    { "type": "header", "content": "Behavior" },
    {
      "type": "select",
      "id": "default_option",
      "label": "Selected by default",
      "options": [
        { "value": "subscription", "label": "Subscribe & save" },
        { "value": "one_time", "label": "One-time purchase" }
      ],
      "default": "subscription"
    },
    { "type": "checkbox", "id": "one_time_first", "label": "Show one-time purchase first", "default": false },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "accent_color", "label": "Selected frequency and badge", "default": "#23395d" },
    { "type": "color", "id": "accent_text_color", "label": "Text on selected frequency", "default": "#ffffff" },
    { "type": "color", "id": "background_color", "label": "Selected option background", "default": "#fdf7ef" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#e9dcc9" },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    }
  ]
}
{% endschema %}
