{
  "extends": "../../tsconfig.json",
  "include": ["shopify.d.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["build", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["DOM", "ES2022"],
    "types": ["@shopify/ui-extensions/preact"],
    "skipLibCheck": true
  }
}
